{
  "permissions": {
    "allow": [
      "Bash(git diff*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git add*)",
      "Bash(npx eslint*)",
      "Bash(npm run lint*)",
      "Bash(npm run test*)",
      "Bash(npm test*)",
      "Bash(grep -r*)",
      "Bash(ls*)",
      "Bash(mkdir*)",
      "Bash(npx tsc *)",
      "Bash(git -C \"E:/cat-prep/catmap-web\" diff HEAD)",
      "Bash(git -C \"E:/cat-prep/catmap-web\" diff HEAD -- \"src/app/cat-prep/daily-challenge/components/SectionHeader.tsx\" \"src/app/cat-prep/daily-challenge/components/QuestionReviewList.tsx\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" show HEAD:\"src/app/cat-prep/daily-challenge/components/ResultView.tsx\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" show HEAD:\"src/app/cat-prep/daily-challenge/components/TestView.tsx\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" diff HEAD -- \"src/app/cat-prep/daily-challenge/components/DailyChallengePageClient.tsx\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" log --oneline -5)",
      "Bash(git -C \"E:/cat-prep/catmap-web\" show HEAD:\"src/app/cat-prep/components/DailyChallengeCard.tsx\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" diff HEAD -- \".claude/settings.json\")",
      "Bash(git -C \"E:/cat-prep/catmap-web\" show HEAD:\"src/app/cat-prep/daily-challenge/components/SectionBreakdownCard.tsx\")"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout --*)",
      "Bash(rm -rf*)",
      "Bash(npm install*)",
      "Bash(npm uninstall*)"
    ],
    "ask": [
      "Bash(git commit*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "cd e:/cat-prep/catmap-web && file=$(echo '$CLAUDE_TOOL_RESULT' | grep -o '\"file_path\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4) && [ -n \"$file\" ] && npx eslint \"$file\" --max-warnings=0 2>&1 || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cmd=$(echo '$CLAUDE_TOOL_INPUT' | grep -o '\"command\":\"[^\"]*\"' | head -1 | cut -d'\"' -f4); case \"$cmd\" in *'git commit'*) cd e:/cat-prep/catmap-web && grep -r 'AIzaSy' src/ 2>/dev/null && echo 'BLOCKED: Firebase key found in src/' && exit 1; echo 'Secret scan passed.';; esac"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo 'Task complete. Next step: run the code-reviewer agent, then test locally before committing.'"
          }
        ]
      }
    ]
  }
}
